# Secretos de las Edge Functions. Copia como supabase/functions/.env para usarlos en local
# (npx supabase functions serve). En la nube: npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los pone Supabase automáticamente: no los añadas.

# Secreto compartido con pg_cron (mínimo 16 caracteres). El mismo valor va en Vault como 'cron_secret'.
CRON_SECRET=cambia-esto-por-una-frase-larga-y-aleatoria

# Emails de aviso a los administradores (https://resend.com → API Keys).
RESEND_API_KEY=
RESEND_FROM=Cerca <avisos@tudominio.es>

# Cabecera Authorization que configures en el webhook de RevenueCat (valor completo).
REVENUECAT_WEBHOOK_AUTH=Bearer cambia-esto

# Opcional: token de acceso de Expo para enviar push (Expo → Account settings → Access tokens).
EXPO_ACCESS_TOKEN=

# Acceso fijo para revisores de App Store y Google Play (ver GUIA_PUBLICACION_TIENDAS.md).
# Sin REVIEW_OTP_CODE la función review-login no deja entrar a nadie.
REVIEW_EMAIL=revisor@cercaapp.es
REVIEW_OTP_CODE=123456
