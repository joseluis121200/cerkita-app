# Copia este archivo como .env y rellena los valores para usar Supabase de verdad.
# Si .env no existe o está vacío, la app arranca en MODO PRUEBA con datos locales.
#
# Supabase local (npx supabase start → copia "API URL" y "anon key"):
#   Desde el móvil NO sirve 127.0.0.1: usa la IP de tu PC en la red WiFi (ej. 192.168.1.40)
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.40:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=pega-aqui-la-anon-key
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
